# AttendTrack — Environment Configuration Template
# Copy to .env for local overrides

# App Environment
VITE_APP_NAME="AttendTrack"
VITE_APP_VERSION="1.0.0"

# Optional Backend Integration URL (when swapping from LocalStorageAdapter to RestApiAdapter)
VITE_API_BASE_URL="http://localhost:5000/api"

# Optional Firebase Adapter Configuration (when swapping to FirebaseStorageAdapter)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
